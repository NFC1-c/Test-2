<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>رأيك يهمّنا!</title>
<style id="custom-styles">
  :root{--bg-color:#ffffff;--hdr-bg:#eef1ef;--card-bg:#ffffff;--text-color:#0d3b26;--border-color:#0d3b26}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg-color);color:var(--text-color);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif;padding-bottom:80px}
  .h{background:var(--hdr-bg);padding:22px 20px;padding-top:calc(22px + env(safe-area-inset-top,0px));text-align:center}
  .h h2{margin:0;font-size:22px}
  .lang{display:inline-flex;gap:6px;background:var(--card-bg);border:1px solid var(--hdr-bg);border-radius:20px;padding:8px 16px;font-size:13px;color:var(--text-color);cursor:pointer;margin-bottom:16px;font-family:inherit}
  .m{max-width:440px;margin:0 auto;padding:26px 20px calc(24px + env(safe-area-inset-bottom,0px))}
  .lg{display:block;width:90px;height:90px;border-radius:20px;object-fit:cover;margin:0 auto 22px}
  h1{font-size:19px;text-align:center;margin:0 0 6px}
  .d{opacity:.85;font-size:13.5px;text-align:center;line-height:1.7;margin:0 0 24px}
  a.c{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--card-bg);color:var(--text-color);text-decoration:none;padding:16px;margin-bottom:16px;border:1.5px solid var(--border-color);border-radius:16px;font-weight:700;font-size:14.5px;line-height:1.6;transition:transform .1s ease}
  a.c:active{transform:scale(.98)}
  .ct{flex:1;text-align:center}
  .ic{width:42px;height:42px;border-radius:50%;background:var(--hdr-bg);display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:20px;flex-shrink:0}
  .ic img,.s img{width:100%;height:100%;object-fit:cover}
  .ch{opacity:.5;font-size:17px}
  [dir=ltr] .ch{transform:scaleX(-1)}
  hr{border:0;border-top:1px solid var(--hdr-bg);margin:28px 0 18px}
  .f{text-align:center;opacity:.75;font-size:13.5px;margin-bottom:16px}
  .so{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
  .s{width:42px;height:42px;border-radius:50%;background:var(--hdr-bg);color:var(--text-color);display:flex;align-items:center;justify-content:center;overflow:hidden;text-decoration:none;font-size:18px}

  /* ===== لوحة التحرير (تظهر فقط مع ?edit) ===== */
  #admin-toggle{position:fixed;bottom:calc(20px + env(safe-area-inset-bottom,0px));left:20px;background:#000;color:#fff;border:none;padding:12px 20px;border-radius:30px;font-weight:bold;cursor:pointer;z-index:9999;box-shadow:0 4px 15px rgba(0,0,0,.3);font-family:inherit}
  #admin-panel{display:none;position:fixed;inset:0;background:#f4f7f6;z-index:9998;overflow-y:auto;color:#222;font-family:system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif;direction:rtl}
  #admin-panel.active{display:block}
  .ahead{position:sticky;top:0;background:#fff;border-bottom:1px solid #ddd;padding:12px 14px;padding-top:calc(12px + env(safe-area-inset-top,0px));display:flex;gap:8px;flex-wrap:wrap;align-items:center;z-index:2}
  .ahead h2{margin:0;font-size:16px;flex:1;min-width:120px}
  .awrap{max-width:600px;margin:0 auto;padding:14px 14px calc(60px + env(safe-area-inset-bottom,0px))}
  .as{background:#fff;padding:16px;border-radius:14px;border:1px solid #ddd;margin-bottom:14px}
  .as h3{margin:0 0 12px;border-bottom:2px solid #00693e;padding-bottom:8px;color:#00693e;font-size:15px}
  .fg{margin-bottom:12px}
  .fg label{display:block;font-size:13px;font-weight:700;margin-bottom:4px}
  .fg input[type=text],.fg textarea,.fg select{width:100%;padding:10px;border:1.5px solid #ccc;border-radius:8px;font-family:inherit;font-size:14px;background:#fff;color:#222}
  .fg textarea{min-height:56px;resize:vertical}
  .cp{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
  .ci{text-align:center;font-size:13px}.ci input{width:100%;height:40px;border:1px solid #ccc;border-radius:8px;padding:2px;cursor:pointer;background:#fff}
  .chk{display:flex;gap:8px;align-items:center;margin:8px 0;font-size:14px}.chk input{width:18px;height:18px}
  .it{background:#fafafa;border:1px solid #ddd;padding:12px;border-radius:12px;margin-bottom:12px}
  .thumb{width:44px;height:44px;border-radius:50%;object-fit:cover;border:1px solid #ddd;display:block;margin:6px 0}
  .thumb.sq{border-radius:10px;width:64px;height:64px}
  .b{padding:10px 14px;border-radius:9px;border:none;cursor:pointer;font-weight:700;font-size:13px;font-family:inherit}
  .bp{background:#00693e;color:#fff}.bd{background:#d9534f;color:#fff}.bs{background:#6c757d;color:#fff}
  .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
  #code{display:none;width:100%;height:150px;direction:ltr;font-size:11px;margin-top:10px;border:1px solid #ccc;border-radius:8px}
  .note{font-size:12.5px;line-height:1.8;color:#555}
</style>
</head>
<body dir="rtl">

<div class="h" id="hdr">
  <button class="lang" id="lang-btn" onclick="toggleLang()">🌐 <span id="lang-txt">English</span></button>
  <h2 id="hdr-title"></h2>
</div>

<div class="m">
  <img id="page-logo" class="lg" alt="Logo">
  <h1 id="main-title"></h1>
  <p id="main-desc" class="d"></p>
  <div id="cards-container"></div>
  <div id="follow-wrap">
    <hr>
    <div class="f" id="social-title"></div>
    <div class="so" id="social-container"></div>
  </div>
</div>

<button id="admin-toggle" onclick="toggleAdmin()">⚙️ تحرير الصفحة</button>

<div id="admin-panel">
  <div class="ahead">
    <h2>🛠️ لوحة التحرير</h2>
    <button class="b bp" onclick="copyCode()">📋 نسخ الكود</button>
    <button class="b bs" onclick="dl()">📥 تنزيل</button>
    <button class="b bs" onclick="toggleAdmin()">معاينة ✕</button>
  </div>
  <div class="awrap">
    <div class="as">
      <p class="note" style="margin:0">تعديلاتك تظهر لك فقط. لتحديث الصفحة الحقيقية: اضغط <b>نسخ الكود</b> ← افتح index.html في GitHub ← أيقونة القلم ← امسح الكل والصق ← Commit changes.</p>
      <textarea id="code" readonly></textarea>
    </div>

    <div class="as"><h3>🎨 الألوان</h3>
      <div class="cp">
        <div class="ci"><label>خلفية الصفحة</label><input type="color" data-c="bg"></div>
        <div class="ci"><label>خلفية الهيدر والأيقونات</label><input type="color" data-c="hdr"></div>
        <div class="ci"><label>خلفية البطاقات</label><input type="color" data-c="card"></div>
        <div class="ci"><label>لون النصوص</label><input type="color" data-c="text"></div>
        <div class="ci"><label>لون الإطار</label><input type="color" data-c="border"></div>
      </div>
    </div>

    <div class="as"><h3>👁️ العناصر الظاهرة</h3>
      <div class="chk"><input type="checkbox" data-s="hdr" id="s1"><label for="s1">عنوان الهيدر</label></div>
      <div class="chk"><input type="checkbox" data-s="lang" id="s2"><label for="s2">زر اللغة</label></div>
      <div class="chk"><input type="checkbox" data-s="logo" id="s3"><label for="s3">الشعار</label></div>
      <div class="chk"><input type="checkbox" data-s="desc" id="s4"><label for="s4">العنوان والوصف</label></div>
      <div class="chk"><input type="checkbox" data-s="follow" id="s5"><label for="s5">قسم تابعنا والسوشيال</label></div>
    </div>

    <div class="as"><h3>🖼️ الشعار</h3>
      <div id="logo-prev"></div>
      <div class="fg"><label>رفع شعار جديد</label><input type="file" accept="image/*" onchange="upImg(this,300,function(d){D.general.logo=d;save();render();redraw()})"></div>
      <button class="b bd" onclick="D.general.logo='';save();render();redraw()">إزالة الشعار</button>
    </div>

    <div class="as"><h3>📝 النصوص</h3>
      <div class="fg"><label>عنوان الهيدر (عربي)</label><input type="text" data-g="hdrAr"></div>
      <div class="fg"><label>عنوان الهيدر (English)</label><input type="text" data-g="hdrEn"></div>
      <div class="fg"><label>العنوان الرئيسي (عربي)</label><input type="text" data-g="titleAr"></div>
      <div class="fg"><label>العنوان الرئيسي (English)</label><input type="text" data-g="titleEn"></div>
      <div class="fg"><label>الوصف (عربي) — &lt;br&gt; لنزول سطر</label><textarea data-g="descAr"></textarea></div>
      <div class="fg"><label>الوصف (English)</label><textarea data-g="descEn"></textarea></div>
      <div class="fg"><label>نص تابعنا (عربي)</label><input type="text" data-g="followAr"></div>
      <div class="fg"><label>نص تابعنا (English)</label><input type="text" data-g="followEn"></div>
    </div>

    <div class="as"><h3>🔗 الخانات والروابط</h3>
      <div id="cards-editor-list"></div>
      <button class="b bp" onclick="addItem('cards')">➕ إضافة خانة</button>
    </div>

    <div class="as"><h3>🌐 السوشيال ميديا</h3>
      <div id="social-editor-list"></div>
      <button class="b bp" onclick="addItem('socials')">➕ إضافة منصة</button>
    </div>

    <div class="as"><button class="b bd" onclick="resetDraft()">↩️ استرجاع النسخة الأصلية (يمسح مسودتك)</button></div>
  </div>
</div>

<script id="cfg" type="application/json">{"colors": {"bg": "#ffffff", "hdr": "#eef1ef", "card": "#ffffff", "text": "#0d3b26", "border": "#0d3b26"}, "show": {"hdr": true, "lang": true, "logo": true, "desc": true, "follow": true}, "general": {"logo": "data:image/png;base64,", "hdrAr": "قيّمنا", "hdrEn": "Rate Us", "titleAr": "رأيك يهمّنا!", "titleEn": "Your feedback matters!", "descAr": "كل تجربة معك تهمّنا، وكلمتك\u003cbr>تصنع فرقًا حقيقيًا في مسيرتنا للأفضل.", "descEn": "Every experience with us counts, and your words\u003cbr>truly shape our journey toward better.", "followAr": "تابعنا على منصات التواصل الاجتماعي", "followEn": "Follow us on social media"}, "cards": [{"visible": true, "ar": "تجربتي رائعة، اود مشاركتها\u003cbr>على قوقل ماب", "en": "My experience was great, I'd like\u003cbr>to share it on Google Maps", "url": "https://maps.app.goo.gl/RVCsubhds8XR54287?g_st=ic", "iconType": "img", "iconValue": "data:image/jpeg;base64,"}, {"visible": true, "ar": "لدي ملاحظات، ارغب في\u003cbr>ايصالها للإدارة", "en": "I have feedback I'd like\u003cbr>to send to management", "url": "https://forms.gle/juXT3tfEmXo5RCjb6", "iconType": "emoji", "iconValue": "💬"}, {"visible": true, "ar": "أحتاج مساعدة فورية، اود\u003cbr>التواصل الآن", "en": "I need immediate help,\u003cbr>contact now", "url": "https://wa.me/966133451555", "iconType": "img", "iconValue": "data:image/jpeg;base64,"}], "socials": [{"visible": true, "name": "Instagram", "url": "https://www.instagram.com/holidayinn?stkn=Z2ZtMDllbG02bnF2", "iconType": "img", "iconValue": "data:image/jpeg;base64,"}, {"visible": true, "name": "TikTok", "url": "https://www.tiktok.com/@holidayinnexpress?_r=1&_t=ZS-9A3bwR4be7A", "iconType": "img", "iconValue": "data:image/jpeg;base64,"}]}</script>
<script>
const ORIGINAL = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
const EDIT = /[?&#]edit/.test(location.search + location.hash);
const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
let D = JSON.parse($('cfg').textContent);
let lang = 'ar';
if (EDIT) { try { const dr = localStorage.getItem('pg_draft'); if (dr) D = JSON.parse(dr); } catch(e) {} }
function save() { if (EDIT) { try { localStorage.setItem('pg_draft', JSON.stringify(D)); } catch(e) {} } }

const VARS = {bg:'--bg-color', hdr:'--hdr-bg', card:'--card-bg', text:'--text-color', border:'--border-color'};
function iconHtml(o) {
  if (o.iconType === 'img' && o.iconValue) return '<img src="' + esc(o.iconValue) + '" alt="">';
  if (o.iconType === 'emoji' && o.iconValue) return '<span>' + esc(o.iconValue) + '</span>';
  return '';
}
function render() {
  const L = lang, g = D.general, s = D.show;
  document.body.dir = L === 'ar' ? 'rtl' : 'ltr';
  document.documentElement.lang = L;
  Object.keys(VARS).forEach(k => document.documentElement.style.setProperty(VARS[k], D.colors[k]));
  document.title = (g.titleAr || '').replace(/<[^>]*>/g, '');
  $('lang-txt').textContent = L === 'ar' ? 'English' : 'عربي';
  $('hdr-title').innerHTML = L === 'ar' ? g.hdrAr : g.hdrEn;
  $('main-title').innerHTML = L === 'ar' ? g.titleAr : g.titleEn;
  $('main-desc').innerHTML = L === 'ar' ? g.descAr : g.descEn;
  $('social-title').innerHTML = L === 'ar' ? g.followAr : g.followEn;
  $('lang-btn').style.display = s.lang ? '' : 'none';
  $('hdr-title').style.display = s.hdr ? '' : 'none';
  $('hdr').style.display = (s.lang || s.hdr) ? '' : 'none';
  if (g.logo) $('page-logo').src = g.logo; else $('page-logo').removeAttribute('src');
  $('page-logo').style.display = (s.logo && g.logo) ? '' : 'none';
  $('main-title').style.display = s.desc ? '' : 'none';
  $('main-desc').style.display = s.desc ? '' : 'none';
  $('follow-wrap').style.display = s.follow ? '' : 'none';
  $('cards-container').innerHTML = D.cards.filter(c => c.visible).map(c => {
    const ih = iconHtml(c);
    return '<a class="c" href="' + esc(c.url) + '" target="_blank" rel="noopener"><span class="ch">‹</span><span class="ct">' + (L === 'ar' ? c.ar : c.en) + '</span>' + (ih ? '<span class="ic">' + ih + '</span>' : '') + '</a>';
  }).join('');
  $('social-container').innerHTML = D.socials.filter(c => c.visible).map(c => {
    const ih = iconHtml(c);
    return '<a class="s" href="' + esc(c.url) + '" target="_blank" rel="noopener" title="' + esc(c.name) + '">' + (ih || esc(c.name)) + '</a>';
  }).join('');
}
function toggleLang() { lang = lang === 'ar' ? 'en' : 'ar'; render(); }
function toggleAdmin() { $('admin-panel').classList.toggle('active'); }

/* ---------- أدوات التحرير ---------- */
function upImg(inp, max, cb) {
  const f = inp.files[0]; if (!f) return;
  const im = new Image();
  im.onload = () => {
    const sc = Math.min(1, max / Math.max(im.width, im.height)), c = document.createElement('canvas');
    c.width = Math.round(im.width * sc); c.height = Math.round(im.height * sc);
    c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
    cb(c.toDataURL('image/png'));
  };
  im.src = URL.createObjectURL(f);
}
function setF(list, i, k, v, redo) {
  const o = D[list][i];
  if (k === 'iconType' && o.iconType !== v) o.iconValue = '';
  o[k] = v; save(); render(); if (redo) redraw();
}
function moveItem(list, i, d) {
  const L = D[list], t = i + d; if (t < 0 || t >= L.length) return;
  [L[i], L[t]] = [L[t], L[i]]; save(); render(); redraw();
}
function delItem(list, i) { if (confirm('هل أنت متأكد من الحذف؟')) { D[list].splice(i, 1); save(); render(); redraw(); } }
function addItem(list) {
  D[list].push(list === 'cards'
    ? {visible:true, ar:'عنوان الخانة الجديدة', en:'New Link Title', url:'https://', iconType:'emoji', iconValue:'🔗'}
    : {visible:true, name:'منصة', url:'https://', iconType:'emoji', iconValue:'🌐'});
  save(); render(); redraw();
}
function iconEditor(list, i) {
  const o = D[list][i];
  return '<div class="fg"><label>الأيقونة</label><select onchange="setF(\'' + list + '\',' + i + ',\'iconType\',this.value,true)">' +
    '<option value="none"' + (o.iconType === 'none' ? ' selected' : '') + '>بدون أيقونة</option>' +
    '<option value="emoji"' + (o.iconType === 'emoji' ? ' selected' : '') + '>إيموجي</option>' +
    '<option value="img"' + (o.iconType === 'img' ? ' selected' : '') + '>صورة من الجهاز</option></select>' +
    (o.iconType === 'emoji' ? '<input type="text" style="margin-top:6px" value="' + esc(o.iconValue) + '" oninput="setF(\'' + list + '\',' + i + ',\'iconValue\',this.value)">' : '') +
    (o.iconType === 'img' ? (o.iconValue ? '<img class="thumb" src="' + esc(o.iconValue) + '">' : '') +
      '<input type="file" accept="image/*" onchange="upImg(this,160,function(d){setF(\'' + list + '\',' + i + ',\'iconValue\',d,true)})">' : '') + '</div>';
}
function itemButtons(list, i) {
  return '<div class="row"><button class="b bs" onclick="moveItem(\'' + list + '\',' + i + ',-1)">⬆️</button><button class="b bs" onclick="moveItem(\'' + list + '\',' + i + ',1)">⬇️</button><button class="b bd" onclick="delItem(\'' + list + '\',' + i + ')">حذف</button></div>';
}
function redraw() {
  $('logo-prev').innerHTML = D.general.logo ? '<img class="thumb sq" src="' + esc(D.general.logo) + '">' : '<p class="note">لا يوجد شعار</p>';
  $('cards-editor-list').innerHTML = D.cards.map((c, i) =>
    '<div class="it"><div class="chk"><input type="checkbox"' + (c.visible ? ' checked' : '') + ' onchange="setF(\'cards\',' + i + ',\'visible\',this.checked)"> <b>خانة #' + (i + 1) + '</b> — إظهار</div>' +
    '<div class="fg"><label>النص (عربي)</label><textarea oninput="setF(\'cards\',' + i + ',\'ar\',this.value)">' + esc(c.ar) + '</textarea></div>' +
    '<div class="fg"><label>النص (English)</label><textarea oninput="setF(\'cards\',' + i + ',\'en\',this.value)">' + esc(c.en) + '</textarea></div>' +
    '<div class="fg"><label>الرابط</label><input type="text" dir="ltr" value="' + esc(c.url) + '" oninput="setF(\'cards\',' + i + ',\'url\',this.value)"></div>' +
    iconEditor('cards', i) + itemButtons('cards', i) + '</div>').join('');
  $('social-editor-list').innerHTML = D.socials.map((c, i) =>
    '<div class="it"><div class="chk"><input type="checkbox"' + (c.visible ? ' checked' : '') + ' onchange="setF(\'socials\',' + i + ',\'visible\',this.checked)"> <b>#' + (i + 1) + '</b> — إظهار</div>' +
    '<div class="fg"><label>اسم المنصة</label><input type="text" value="' + esc(c.name) + '" oninput="setF(\'socials\',' + i + ',\'name\',this.value)"></div>' +
    '<div class="fg"><label>الرابط</label><input type="text" dir="ltr" value="' + esc(c.url) + '" oninput="setF(\'socials\',' + i + ',\'url\',this.value)"></div>' +
    iconEditor('socials', i) + itemButtons('socials', i) + '</div>').join('');
}
function fillAdmin() {
  document.querySelectorAll('[data-c]').forEach(e => e.value = D.colors[e.dataset.c]);
  document.querySelectorAll('[data-g]').forEach(e => e.value = D.general[e.dataset.g] || '');
  document.querySelectorAll('[data-s]').forEach(e => e.checked = !!D.show[e.dataset.s]);
  redraw();
  $('admin-panel').addEventListener('input', e => {
    const t = e.target;
    if (t.dataset.g) D.general[t.dataset.g] = t.value;
    else if (t.dataset.c) D.colors[t.dataset.c] = t.value;
    else return;
    save(); render();
  });
  $('admin-panel').addEventListener('change', e => {
    const t = e.target;
    if (t.dataset.s) { D.show[t.dataset.s] = t.checked; save(); render(); }
  });
}
function build() {
  const cfg = JSON.stringify(D).replace(/</g, '\\u003c');
  const ttl = (D.general.titleAr || '').replace(/<[^>]*>/g, '');
  return ORIGINAL
    .replace(/(<script id="cfg" type="application\/json">)[\s\S]*?(<\/script>)/, (m, a, b) => a + cfg + b)
    .replace(/<title>[\s\S]*?<\/title>/, () => '<title>' + esc(ttl) + '</title>');
}
async function copyCode() {
  const h = build(), t = $('code'); t.value = h; t.style.display = 'block'; t.focus(); t.select();
  try { await navigator.clipboard.writeText(h); alert('تم نسخ الكود ✓'); }
  catch(e) { try { document.execCommand('copy'); alert('تم نسخ الكود ✓'); } catch(x) { alert('حدد النص في المربع وانسخه يدويًا'); } }
}
function dl() {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([build()], {type:'text/html;charset=utf-8'}));
  a.download = 'index.html'; document.body.appendChild(a); a.click(); a.remove();
}
function resetDraft() { if (confirm('يمسح مسودتك ويرجع للنسخة الأصلية؟')) { try { localStorage.removeItem('pg_draft'); } catch(e) {} location.reload(); } }

render();
if (EDIT) { fillAdmin(); } else { $('admin-toggle').remove(); $('admin-panel').remove(); }
</script>
</body>
</html>
